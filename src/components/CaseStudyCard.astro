---
interface Props {
  href: string;
  stage: string;
  industry: string;
  title: string;
  description: string;
  resultMetric: string;
}

const { href, stage, industry, title, description, resultMetric } = Astro.props;
---

<a href={href} class="card">
  <div class="card__tags">
    <span class="card__tag card__tag--stage">{stage}</span>
    <span class="card__tag">{industry}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="card__result">
    <span class="card__result-label">Result</span>
    <span class="card__result-value">{resultMetric}</span>
  </div>
  <span class="card__link">Read case study →</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 26px;
    text-decoration: none;
    color: inherit;
  }

  .card:hover {
    border-color: var(--color-border-strong);
  }

  .card__tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .card__tag {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-surface-alt);
    color: var(--color-ink-faint);
  }

  .card__tag--stage {
    background: var(--color-accent-tint);
    color: var(--color-accent);
  }

  .card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    margin: 0;
    color: var(--color-ink);
  }

  .card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    flex-grow: 1;
  }

  .card__result {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
  }

  .card__result-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card__result-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    color: var(--color-accent);
  }

  .card__link {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-ink);
  }
</style>
