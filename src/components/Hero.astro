---
import { site, heroMetrics } from '../data/site';

const sparkWidth = 72;
const sparkHeight = 30;

function sparkPoints(values: readonly number[]) {
  const min = Math.min(...values);
  const max = Math.max(...values);
  const range = max - min || 1;
  return values
    .map((v, i) => {
      const x = (i / (values.length - 1)) * sparkWidth;
      const y = sparkHeight - ((v - min) / range) * (sparkHeight - 4) - 2;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
}

function sparkArea(values: readonly number[]) {
  const points = sparkPoints(values);
  return `0,${sparkHeight} ${points} ${sparkWidth},${sparkHeight}`;
}
---

<section class="hero">
  <div class="hero__copy">
    <p class="hero__eyebrow">{site.eyebrow}</p>
    <h1>The door to your <span>next round.</span></h1>
    <p class="hero__lede">{site.description}</p>
    <div class="hero__actions">
      <a href="/#contact" class="btn btn--primary">Book a Call</a>
      <a href="/#services" class="btn btn--secondary">See Services</a>
    </div>
  </div>

  <div class="hero__metrics">
    {heroMetrics.map((metric) => (
      <div class="metric-card">
        <div class="metric-card__top">
          <span class="metric-card__value">{metric.value}</span>
          <svg
            class="metric-card__spark"
            width={sparkWidth}
            height={sparkHeight}
            viewBox={`0 0 ${sparkWidth} ${sparkHeight}`}
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <polygon points={sparkArea(metric.spark)} fill="var(--color-accent-tint)" />
            <polyline points={sparkPoints(metric.spark)} fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <p class="metric-card__label">{metric.label}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 56px 40px 0;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    margin: 0 0 18px;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 4.6vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 22px;
    color: var(--color-ink);
  }

  h1 span {
    color: var(--color-accent);
  }

  .hero__lede {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--color-ink-soft);
    max-width: 50ch;
    margin: 0 0 32px;
  }

  .hero__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14.5px;
    text-decoration: none;
    padding: 13px 24px;
    border-radius: var(--radius-sm);
    border: 1.5px solid transparent;
  }

  .btn--primary {
    background: var(--color-navy);
    color: var(--color-invert-ink);
  }

  .btn--primary:hover {
    background: var(--color-navy-soft);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border-strong);
  }

  .btn--secondary:hover {
    background: var(--color-surface-alt);
  }

  .hero__metrics {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .metric-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 18px 20px;
  }

  .metric-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .metric-card__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .metric-card__label {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink-faint);
  }

  @media (max-width: 860px) {
    .hero {
      padding: 36px 20px 0;
      grid-template-columns: 1fr;
    }
  }
</style>
